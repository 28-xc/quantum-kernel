watch_file flake.nix shell.nix scripts/dev-shell nix/pins.toml nix/resolve-inputs.nix
while IFS= read -r -d '' input; do watch_file "$input"; done < <(find nix -name '*.nix' -print0)
load_project_shell() {
  local dump changes
  dump=$(bash ./scripts/dev-shell --command "$direnv" dump gzenv "") || return
  changes=$("$direnv" apply_dump <(printf '%s\n' "$dump")) || return
  local NIX_BUILD_TOP TMP TMPDIR TEMP TEMPDIR
  eval "$changes"
}
load_project_shell
